<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Campus_live_rewrite</RootNamespace>
    <!-- Force the output binary to `CampusServer` (Linux) / `CampusServer.exe` (Windows) so
         the systemd unit + install.sh reference a consistent name regardless of what the
         .csproj file happens to be called. -->
    <AssemblyName>CampusServer</AssemblyName>
    <!-- Workstation (concurrent) GC instead of Server GC: on a small 4-core VPS Server GC reserves
         a per-core heap and holds far more resident memory than a few dozen players need. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Data\APIS\customitems.json" />
    <Content Remove="Data\APIS\LoadingScreenTipData.json" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="api\dbs\NewFile.txt" />
    <None Remove="api\server\NewFile.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.18.0" />
    <PackageReference Include="Discord.Net.Commands" Version="3.18.0" />
    <PackageReference Include="Discord.Net.Core" Version="3.18.0" />
    <PackageReference Include="Discord.Net.Interactions" Version="3.18.0" />
    <PackageReference Include="JWT" Version="11.0.0" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data\APIS\customitems.json" />
    <None Include="Data\APIS\LoadingScreenTipData.json" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\APIS\Charades\" />
    <Folder Include="Data\APIS\WatchPages\" />
    <Folder Include="Data\DBs\" />
    <Folder Include="Data\Videos\" />
  </ItemGroup>

</Project>
