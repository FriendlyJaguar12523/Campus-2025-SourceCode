@@ -80,6 +82,13 @@ namespace lnl {
         bool disconnect_on_unreachable = false;
         std::string name;
 
+        // Optional datagram transform layers (a generic hook, equivalent to the C# PacketLayerBase).
+        // outbound_layer: given the packet about to be sent, fill `out` with the bytes to put on the
+        //   wire and return their length. inbound_layer: mutate a freshly received datagram in place
+        //   and return the new length, or 0 to drop it. Used by Tachyon for the RecRoom 0x11 marker.
+        std::function<size_t(const uint8_t* data, size_t length, std::vector<uint8_t>& out)> outbound_layer;
+        std::function<size_t(uint8_t* data, size_t length)> inbound_layer;
+
         explicit net_manager(net_event_listener* listener);
 
         ~net_manager();
diff --git a/src/lnl/net_manager.cpp b/src/lnl/net_manager.cpp
index 0cfe2a7..fa23eef 100644
--- a/src/lnl/net_manager.cpp
+++ b/src/lnl/net_manager.cpp
@@ -219,6 +219,15 @@ void lnl::net_manager::receive_logic() {
 
         packet->resize(size);
 
+        if (inbound_layer) {
+            size_t newLen = inbound_layer(packet->data(), (size_t) size);
+            if (newLen == 0) {          // layer dropped the datagram (unknown/undecryptable marker)
+                pool_recycle(packet);
+                continue;
+            }
+            packet->resize(newLen);
+        }
+
         on_message_received(packet, addr);
     }
 }
