      <SDLCheck>true</SDLCheck>
      <!-- Notes on this weird set of defines:
             * _DEBUG is INTENTIONALLY OMITTED. It would make the CRT call the debug-heap
               variants (_malloc_dbg / _calloc_dbg / _free_dbg / _CrtDbgReport) which only
               exist in msvcrtd.dll. We're linking /MD (release CRT) below, so those symbols
               are missing and we'd get LNK2001/LNK2019 on every allocation.
             * PATCH_DEBUG is our own gate for anti-cheat log visibility etc. Use this in
               source instead of _DEBUG. See src\Protections\AntiLog.h.
             * _ITERATOR_DEBUG_LEVEL=0 matches the prebuilt discord-rpc.lib's iterator debug
               setting so LNK2038 doesn't fire on the CRT flag check. -->
      <PreprocessorDefinitions>PATCH_DEBUG;MY2025Patch_EXPORTS;_WINDOWS;_USRDLL;_ITERATOR_DEBUG_LEVEL=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- Match discord-rpc.lib's CRT (Release DLL) instead of Debug DLL. Same reason -
           the third-party lib only ships one flavour and won't link against MDd. You keep
           PDBs and stepping; only the CRT's iterator/heap debug checks go away. -->
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
          <AdditionalIncludeDirectories>$(ProjectDir)src\RR\imgui;$(ProjectDir)src\Discord\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
</ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableUAC>false</EnableUAC>
    </Link>
  </ItemDefinitionGroup>
